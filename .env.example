# ===================================================================
# AICTE Sentinel — Environment Configuration Template
# Problem Statement 26262 | SIH 2026
# ===================================================================

# --- General Environment ---
ENVIRONMENT=development
DEBUG=True
APP_NAME="AICTE Sentinel"
APP_VERSION=1.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# --- Security & Secrets ---
# Generate using: openssl rand -hex 32
SECRET_KEY=change-this-in-production-super-secret-key-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database (PostgreSQL + pgvector) ---
# For local development with Docker Compose:
DATABASE_URL=postgresql+asyncpg://sentinel_user:sentinel_pass@localhost:5432/aicte_sentinel
# Fallback / sync URL for Alembic migrations:
DATABASE_SYNC_URL=postgresql://sentinel_user:sentinel_pass@localhost:5432/aicte_sentinel
# Set to True for SQLite fallback when running standalone without Docker:
USE_SQLITE_FALLBACK=False
SQLITE_DB_PATH=./sentinel_dev.db

# --- Redis (Cache & Background Worker) ---
REDIS_URL=redis://localhost:6379/0

# --- Object Storage (MinIO / S3) ---
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_QUARANTINE=aicte-quarantine
STORAGE_BUCKET_VAULT=aicte-vault
STORAGE_USE_SSL=False

# --- Antivirus Service (ClamAV) ---
CLAMAV_ENABLED=False
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Audit & Cryptographic Anchoring ---
AUDIT_MERKLE_SALT=sentinel-merkle-secret-salt-2026
MERKLE_BATCH_INTERVAL_MINUTES=60

# --- Seed Configuration ---
SEED_SUPERADMIN_EMAIL=superadmin@aicte-india.org
SEED_SUPERADMIN_PASSWORD=Sentinel@Admin2026!
SEED_SYNTHETIC_DATA=True
